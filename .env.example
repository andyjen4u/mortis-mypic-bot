DISCORD_TOKEN=
DISCORD_GUILD_ID=
DATA_DIR=/var/lib/mortis-bot

# 自動回覆：私訊直接回；伺服器預設僅在提及 Bot 時回覆。
AUTO_REPLY_ENABLED=true
AUTO_REPLY_DMS=true
AUTO_REPLY_GUILD_MENTIONS_ONLY=true
# 逗號分隔的頻道 ID；列出的頻道不需要提及 Bot。
AUTO_REPLY_CHANNEL_IDS=
AUTO_REPLY_COOLDOWN_SECONDS=10

# 每次選圖的檢索候選、分數及模型簡短理由會寫入 JSONL。
DECISION_LOG_ENABLED=true
# 留空時使用 DATA_DIR/decisions.jsonl。
DECISION_LOG_PATH=

# OpenAI-compatible chat completion endpoint；留空時使用資料庫搜尋第一名。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible embedding endpoint
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 圖片來源與下載保護設定
MYPIC_DB_URL=https://raw.githubusercontent.com/Its-MyPic/Its-MyPicDB/json/data.json
MYPIC_IMAGE_BASE_URL=https://mypic.0m0.uk/images
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_DELAY_SECONDS=0.25
DOWNLOAD_TIMEOUT_SECONDS=30
