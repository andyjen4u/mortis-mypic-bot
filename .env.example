DISCORD_TOKEN=
DISCORD_GUILD_ID=
DATA_DIR=/var/lib/mortis-bot

# 自動回圖模式：always=每則都回、auto=智慧判斷、off=關閉被動回圖。
# off 模式下，被提及與 /mypic 仍會強制選圖。
AUTO_REPLY_MODE=auto
AUTO_REPLY_ACTIVITY=medium
CONTEXT_MESSAGE_LIMIT=5
AUTO_REPLY_ENABLED=true
AUTO_REPLY_DMS=true
# 以下兩項保留供舊版部署相容；新模式可用 /mypic-settings 分頻道設定。
AUTO_REPLY_GUILD_MENTIONS_ONLY=true
# 逗號分隔的頻道 ID；列出的頻道不需要提及 Bot。
AUTO_REPLY_CHANNEL_IDS=
AUTO_REPLY_COOLDOWN_SECONDS=10

# 每次選圖的檢索候選、分數及模型簡短理由會寫入 JSONL。
DECISION_LOG_ENABLED=true
# 留空時使用 DATA_DIR/decisions.jsonl。
DECISION_LOG_PATH=
# OpenAI-compatible chat completion endpoint；用來規劃是否插話、反應角色與
# 動態字幕搜尋詞。留空時 Auto 模式會安全地保持沉默。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 機器人在對話中可能被叫的名稱，供模型判斷自己是否為被談論的當事人。
BOT_ALIASES=Mortis,Motis
# 正常情況直接採用 cross-encoder 結果；啟用後會再呼叫一次聊天模型選圖。
FINAL_JUDGE_ENABLED=false

# OpenAI-compatible embedding endpoint
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 專用 cross-encoder reranker；依 planner 選定的觀點重排混合召回候選。
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RETRIEVAL_POOL_SIZE=16
RERANKER_TOP_N=5

# 圖片來源與下載保護設定
MYPIC_DB_URL=https://raw.githubusercontent.com/Its-MyPic/Its-MyPicDB/json/data.json
MYPIC_IMAGE_BASE_URL=https://mypic.0m0.uk/images
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_DELAY_SECONDS=0.25
DOWNLOAD_TIMEOUT_SECONDS=30
