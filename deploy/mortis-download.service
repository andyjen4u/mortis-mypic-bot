[Unit]
Description=Download remaining Its-MyPic images
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mortisbot
Group=mortisbot
WorkingDirectory=/opt/mortis-bot
EnvironmentFile=/etc/mortis-bot.env
ExecStart=/opt/mortis-bot/.venv/bin/mortis-data download --all
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mortis-bot

